---
import Layout from "@/layouts/Layout.astro";
import Sidebar from "@/components/Sidebar.astro";
import MobileHeader from "@/components/MobileHeader.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TimelineEntry from "@/components/TimelineEntry.astro";
import Card from "@/components/Card.astro";
import Tag from "@/components/Tag.astro";
import Highlights from "@/components/Highlights.astro";
import resume from "@/assets/resume.json";

const {
  basics,
  work,
  volunteer,
  education,
  awards,
  certificates,
  publications,
  skills,
  languages,
  interests,
  projects,
  references,
} = resume;

function formatDate(dateStr: string | null): string {
  if (!dateStr) return "Present";
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

function dateRange(start: string, end: string | null): string {
  return `${formatDate(start)} — ${formatDate(end)}`;
}

const initials = basics.name
  .split(" ")
  .map((n: string) => n[0])
  .join("");

const navItems = [
  { id: "about", label: "About" },
  { id: "experience", label: "Experience" },
  { id: "education", label: "Education" },
  { id: "skills", label: "Skills" },
  { id: "projects", label: "Projects" },
  { id: "awards", label: "Awards" },
  { id: "certificates", label: "Certificates" },
  { id: "publications", label: "Publications" },
  { id: "languages", label: "Languages" },
  { id: "interests", label: "Interests" },
];
---

<Layout title={`${basics.name} — ${basics.label}`}>
  <div class="min-h-screen bg-zinc-950 text-zinc-200 font-display">
    <Sidebar
      name={basics.name}
      initials={initials}
      label={basics.label}
      city={basics.location.city}
      region={basics.location.region}
      email={basics.email}
      navItems={navItems}
      profiles={basics.profiles}
    />

    <MobileHeader
      name={basics.name}
      initials={initials}
      label={basics.label}
      navItems={navItems}
    />

    <main class="lg:ml-64">
      <!-- Hero / About -->
      <section id="about" class="relative px-8 py-24 lg:px-16 lg:py-32">
        <div
          class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"
        >
        </div>
        <div class="relative max-w-3xl">
          <p
            class="text-emerald-400 font-share-tech-mono text-sm mb-4 tracking-wider uppercase"
          >
            About Me
          </p>
          <h2
            class="text-4xl lg:text-5xl font-bold text-white leading-tight mb-6"
          >
            Hi, I'm <span
              class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent"
              >{basics.name.split(" ")[0]}</span
            >
          </h2>
          <p class="text-lg text-zinc-400 leading-relaxed mb-8">
            {basics.summary}
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href={`mailto:${basics.email}`}
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 text-sm font-semibold rounded-lg transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                  d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
              >
              Contact Me
            </a>
            {
              basics.profiles.map((p: any) => (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 border border-zinc-700 hover:border-emerald-500 text-zinc-300 hover:text-white text-sm rounded-lg transition-colors"
                >
                  {p.network}
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Experience -->
      <section
        id="experience"
        class="px-8 py-16 lg:px-16 border-t border-zinc-800"
      >
        <SectionHeader label="Work" title="Experience" />
        <div class="space-y-10">
          {
            work.map((job: any) => (
              <TimelineEntry
                title={job.position}
                subtitle={job.name}
                subtitleUrl={job.url}
                dateRange={dateRange(job.startDate, job.endDate)}
                summary={job.summary}
                highlights={job.highlights}
              />
            ))
          }
        </div>

        {
          volunteer.length > 0 && (
            <div class="mt-16">
              <h4 class="text-lg font-bold text-white mb-6">Volunteer</h4>
              <div class="space-y-10">
                {volunteer.map((v: any) => (
                  <TimelineEntry
                    title={v.position}
                    subtitle={v.organization}
                    dateRange={dateRange(v.startDate, v.endDate)}
                    summary={v.summary}
                    accent="cyan"
                  />
                ))}
              </div>
            </div>
          )
        }
      </section>

      <!-- Education -->
      <section
        id="education"
        class="px-8 py-16 lg:px-16 border-t border-zinc-800"
      >
        <SectionHeader label="Academic" title="Education" />
        <div class="space-y-8">
          {
            education.map((edu: any) => (
              <Card>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                  <h4 class="text-lg font-semibold text-white">
                    {edu.studyType} in {edu.area}
                  </h4>
                  <span class="text-xs text-zinc-500 font-share-tech-mono whitespace-nowrap">
                    {dateRange(edu.startDate, edu.endDate)}
                  </span>
                </div>
                <a
                  href={edu.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors"
                >
                  {edu.institution}
                </a>
                {edu.score && (
                  <p class="text-xs text-zinc-500 mt-2">
                    GPA: <span class="text-zinc-300">{edu.score}</span>
                  </p>
                )}
                {edu.courses && edu.courses.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-3">
                    {edu.courses.map((c: string) => (
                      <Tag>{c}</Tag>
                    ))}
                  </div>
                )}
              </Card>
            ))
          }
        </div>
      </section>

      <!-- Skills -->
      <section id="skills" class="px-8 py-16 lg:px-16 border-t border-zinc-800">
        <SectionHeader label="Expertise" title="Skills" />
        <div class="space-y-8">
          {
            skills.map((skill: any) => (
              <div>
                <div class="flex items-baseline justify-between mb-3">
                  <h4 class="text-base font-semibold text-white">
                    {skill.name}
                  </h4>
                  <span class="text-xs text-zinc-500 font-share-tech-mono">
                    {skill.level}
                  </span>
                </div>
                <div class="flex flex-wrap gap-2">
                  {skill.keywords.map((kw: string) => (
                    <Tag size="md">{kw}</Tag>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Projects -->
      <section
        id="projects"
        class="px-8 py-16 lg:px-16 border-t border-zinc-800"
      >
        <SectionHeader label="Built" title="Projects" />
        <div class="grid gap-6 sm:grid-cols-2">
          {
            projects.map((proj: any) => (
              <Card href={proj.url || null}>
                <div class="flex items-start justify-between mb-3">
                  <h4 class="text-lg font-semibold text-white group-hover:text-emerald-400 transition-colors">
                    {proj.name}
                  </h4>
                  {proj.url && (
                    <span class="text-zinc-500 group-hover:text-emerald-400 transition-colors">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                      </svg>
                    </span>
                  )}
                </div>
                <p class="text-sm text-zinc-400 mb-3">{proj.description}</p>
                <span class="text-xs text-zinc-600 font-share-tech-mono">
                  {dateRange(proj.startDate, proj.endDate)}
                </span>
                <Highlights items={proj.highlights || []} />
              </Card>
            ))
          }
        </div>
      </section>

      <!-- Awards -->
      <section id="awards" class="px-8 py-16 lg:px-16 border-t border-zinc-800">
        <SectionHeader label="Recognition" title="Awards" />
        <div class="space-y-4">
          {
            awards.map((award: any) => (
              <Card>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
                  <h4 class="text-base font-semibold text-white">
                    {award.title}
                  </h4>
                  <span class="text-xs text-zinc-500 font-share-tech-mono whitespace-nowrap">
                    {formatDate(award.date)}
                  </span>
                </div>
                <p class="text-sm text-emerald-400">{award.awarder}</p>
                {award.summary && (
                  <p class="text-sm text-zinc-400 mt-2">{award.summary}</p>
                )}
              </Card>
            ))
          }
        </div>
      </section>

      <!-- Certificates -->
      <section
        id="certificates"
        class="px-8 py-16 lg:px-16 border-t border-zinc-800"
      >
        <SectionHeader label="Credentials" title="Certificates" />
        <div class="grid gap-4 sm:grid-cols-2">
          {
            certificates.map((cert: any) => (
              <Card href={cert.url}>
                <h4 class="text-base font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  {cert.name}
                </h4>
                <p class="text-sm text-zinc-500 mt-1">{cert.issuer}</p>
                <span class="text-xs text-zinc-600 font-share-tech-mono mt-2 block">
                  {formatDate(cert.date)}
                </span>
              </Card>
            ))
          }
        </div>
      </section>

      <!-- Publications -->
      <section
        id="publications"
        class="px-8 py-16 lg:px-16 border-t border-zinc-800"
      >
        <SectionHeader label="Published" title="Publications" />
        <div class="space-y-4">
          {
            publications.map((pub: any) => (
              <Card href={pub.url}>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
                  <h4 class="text-base font-semibold text-white group-hover:text-emerald-400 transition-colors">
                    {pub.name}
                  </h4>
                  <span class="text-xs text-zinc-500 font-share-tech-mono whitespace-nowrap">
                    {formatDate(pub.releaseDate)}
                  </span>
                </div>
                <p class="text-sm text-emerald-400">{pub.publisher}</p>
                {pub.summary && (
                  <p class="text-sm text-zinc-400 mt-2">{pub.summary}</p>
                )}
              </Card>
            ))
          }
        </div>
      </section>

      <!-- Languages & Interests -->
      <section
        id="languages"
        class="px-8 py-16 lg:px-16 border-t border-zinc-800"
      >
        <div class="grid gap-16 sm:grid-cols-2">
          <div>
            <SectionHeader label="Communication" title="Languages" />
            <div class="space-y-4">
              {
                languages.map((lang: any) => (
                  <div class="flex items-center justify-between p-4 bg-zinc-900 border border-zinc-800 rounded-xl">
                    <span class="text-base text-white font-medium">
                      {lang.language}
                    </span>
                    <span class="text-xs text-zinc-500 font-share-tech-mono">
                      {lang.fluency}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <div id="interests">
            <SectionHeader label="Beyond Code" title="Interests" />
            <div class="space-y-4">
              {
                interests.map((interest: any) => (
                  <Card>
                    <h4 class="text-base text-white font-medium mb-2">
                      {interest.name}
                    </h4>
                    <div class="flex flex-wrap gap-2">
                      {interest.keywords.map((kw: string) => (
                        <Tag>{kw}</Tag>
                      ))}
                    </div>
                  </Card>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- References -->
      {
        references.length > 0 && (
          <section
            id="references"
            class="px-8 py-16 lg:px-16 border-t border-zinc-800"
          >
            <SectionHeader label="Endorsed By" title="References" />
            <div class="grid gap-4 sm:grid-cols-2">
              {references.map((ref: any) => (
                <Card hover={false}>
                  <h4 class="text-base font-semibold text-white">{ref.name}</h4>
                  {ref.reference && (
                    <p class="text-sm text-zinc-400 mt-2 italic">
                      "{ref.reference}"
                    </p>
                  )}
                </Card>
              ))}
            </div>
          </section>
        )
      }

      <!-- Footer -->
      <footer class="px-8 py-8 lg:px-16 border-t border-zinc-800">
        <div
          class="flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <p class="text-xs text-zinc-600">
            &copy; {new Date().getFullYear()}
            {basics.name}. All rights reserved.
          </p>
          <div class="flex gap-4">
            {
              basics.profiles.map((p: any) => (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-zinc-600 hover:text-emerald-400 transition-colors"
                >
                  {p.network}
                </a>
              ))
            }
            <a
              href={`mailto:${basics.email}`}
              class="text-xs text-zinc-600 hover:text-emerald-400 transition-colors"
              >Email</a
            >
          </div>
        </div>
      </footer>
    </main>
  </div>
</Layout>
