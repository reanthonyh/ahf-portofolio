---
interface Props {
  title: string;
  subtitle: string;
  subtitleUrl?: string | null;
  dateRange: string;
  summary?: string;
  highlights?: string[];
  accent?: "emerald" | "cyan";
}

const { title, subtitle, subtitleUrl, dateRange, summary, highlights = [], accent = "emerald" } = Astro.props;

const dotClass = accent === "cyan"
  ? "group-hover:bg-cyan-500"
  : "group-hover:bg-emerald-500";

const borderClass = accent === "cyan"
  ? "hover:border-cyan-500"
  : "hover:border-emerald-500";
---

<div class={`relative pl-8 border-l border-zinc-800 ${borderClass} transition-colors group`}>
  <div class={`absolute left-0 top-1 w-2.5 h-2.5 rounded-full bg-zinc-700 ${dotClass} transition-colors -translate-x-[5.5px]`}></div>
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
    <h4 class="text-lg font-semibold text-white">{title}</h4>
    <span class="text-xs text-zinc-500 font-share-tech-mono whitespace-nowrap">{dateRange}</span>
  </div>
  {subtitleUrl ? (
    <a href={subtitleUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-emerald-400 hover:text-emerald-300 transition-colors">
      {subtitle}
    </a>
  ) : (
    <p class="text-sm text-emerald-400">{subtitle}</p>
  )}
  {summary && <p class="text-sm text-zinc-400 mt-2">{summary}</p>}
  {highlights.length > 0 && (
    <ul class="mt-3 space-y-1">
      {highlights.map((h: string) => (
        <li class="text-sm text-zinc-500 flex items-start gap-2">
          <span class="text-emerald-500 mt-1.5">▸</span>
          {h}
        </li>
      ))}
    </ul>
  )}
</div>
