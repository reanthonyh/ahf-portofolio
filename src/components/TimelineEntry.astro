---
interface Props {
  title: string;
  subtitle: string;
  subtitleUrl?: string | null;
  dateRange: string;
  summary?: string;
  highlights?: string[];
}

const {
  title,
  subtitle,
  subtitleUrl,
  dateRange,
  summary,
  highlights = [],
} = Astro.props;
---

<div
  class={`relative pl-8 border-l border-umbrella-line hover:border-umbrella-green transition-colors group`}
>
  <div
    class={`absolute left-0 top-1 w-2.5 h-2.5 bg-umbrella-muted group-hover:bg-umbrella-green transition-colors -translate-x-1.5`}
  >
  </div>
  <div
    class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2"
  >
    <h4 class="text-lg scan-text text-white uppercase tracking-wide">
      {title}
    </h4>
    <span class="data-glow text-xs font-share-tech-mono whitespace-nowrap"
      >{dateRange}</span
    >
  </div>
  {
    subtitleUrl ? (
      <a
        href={subtitleUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-umbrella-green hover:text-white transition-colors"
      >
        {subtitle}
      </a>
    ) : (
      <p class="text-sm text-umbrella-green">{subtitle}</p>
    )
  }
  {summary && <p class="text-sm text-zinc-400 mt-2 scan-text">{summary}</p>}
  {
    highlights.length > 0 && (
      <ul class="mt-3 space-y-1">
        {highlights.map((h: string) => (
          <li class="text-sm text-umbrella-muted flex items-start gap-2">
            <span class="text-umbrella-green mt-1.5">▸</span>
            {h}
          </li>
        ))}
      </ul>
    )
  }
</div>
