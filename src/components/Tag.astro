---
interface Props {
  size?: "sm" | "md";
}

const { size = "sm" } = Astro.props;

const sizeClass = size === "md"
  ? "text-sm px-3 py-1.5"
  : "text-xs px-2.5 py-1";
---

<span
  class={`inline-block font-share-tech-mono uppercase tracking-wider border border-umbrella-line bg-white/5 text-umbrella-muted hover:border-umbrella-green/60 hover:text-umbrella-green transition-colors ${sizeClass}`}
>
  <slot />
</span>
