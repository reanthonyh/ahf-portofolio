---
interface Props {
  size?: "sm" | "md";
}

const { size = "sm" } = Astro.props;

const sizeClass = size === "md"
  ? "text-sm px-3 py-1.5"
  : "text-xs px-2.5 py-1";
---

<span class={`${sizeClass} bg-zinc-800 text-zinc-400 rounded-md border border-zinc-700 hover:border-emerald-500/40 hover:text-emerald-400 transition-colors`}>
  <slot />
</span>
