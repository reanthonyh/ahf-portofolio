---
import Avatar from "./Avatar.astro";
import "@fontsource/inter";

interface NavItem {
  id: string;
  label: string;
}

interface Props {
  name: string;
  initials: string;
  label: string;
  navItems: NavItem[];
}

const { name, initials, label, navItems } = Astro.props;
---

<header
  class="lg:hidden sticky top-0 z-50 bg-black/80 backdrop-blur-md border-b-2 border-umbrella-line px-6 py-4"
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <Avatar initials={initials} size="sm" />
      <div>
        <h1 class="text-sm scan-text text-white uppercase tracking-wider">
          {name}
        </h1>
        <p class="text-xs data-glow font-share-tech-mono">{label}</p>
      </div>
    </div>
    <nav class="flex items-center gap-2 pl-2">
      {
        navItems.slice(0, 3).map((item) => (
          <a href={`#${item.id}`} class="hud-prompt">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
