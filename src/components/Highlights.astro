---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="mt-3 space-y-1">
      {items.map((h: string) => (
        <li class="text-sm text-umbrella-muted flex items-start gap-2">
          <span class="text-umbrella-green mt-1.5">▸</span>
          {h}
        </li>
      ))}
    </ul>
  )
}
