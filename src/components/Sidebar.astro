---
import Avatar from "./Avatar.astro";

interface NavItem {
  id: string;
  label: string;
}

interface Profile {
  network: string;
  url: string;
}

interface Props {
  name: string;
  initials: string;
  label: string;
  city: string;
  region: string;
  email: string;
  navItems: NavItem[];
  profiles: Profile[];
}

const { name, initials, label, city, region, email, navItems, profiles } =
  Astro.props;
---

<aside
  class="fixed inset-y-0 left-0 w-64 bg-zinc-900 border-r border-zinc-800 lg:flex not-lg:hidden flex-col justify-start overflow-y-auto"
>
  <div class="p-6">
    <Avatar initials={initials} size="md" />
    <h1 class="text-xl font-bold text-white mt-4">{name}</h1>
    <p class="text-sm text-emerald-400 font-share-tech-mono mt-1">{label}</p>
    <p class="text-xs text-zinc-500 mt-2">{city}, {region}</p>
  </div>

  <nav class="px-4 pb-6 pt-12">
    <ul class="space-y-1">
      {
        navItems.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="block px-3 py-2 text-sm text-zinc-400 hover:text-white hover:bg-zinc-800 rounded transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
