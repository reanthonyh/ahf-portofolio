---
import Avatar from "./Avatar.astro";

interface NavItem {
  id: string;
  label: string;
}

interface Profile {
  network: string;
  url: string;
}

interface Props {
  name: string;
  initials: string;
  label: string;
  city: string;
  region: string;
  email: string;
  navItems: NavItem[];
  profiles: Profile[];
}

const { name, initials, label, city, region, email, navItems, profiles } =
  Astro.props;
---

<aside
  class="fixed inset-y-0 left-0 w-64 bg-umbrella-surface border-r-2 border-umbrella-line lg:flex not-lg:hidden flex-col justify-start overflow-y-auto z-10"
>
  <div class="p-6">
    <Avatar initials={initials} size="md" />
    <h1 class="text-xl scan-text text-white mt-4 uppercase tracking-wider">{name}</h1>
    <p class="text-sm data-glow font-share-tech-mono mt-1 uppercase tracking-wide"
      >{label}</p
    >
    <p class="text-xs text-umbrella-muted font-share-tech-mono mt-2"
      >{city}, {region}</p
    >
  </div>

  <nav class="px-4 pb-6 pt-12">
    <p class="text-xs text-umbrella-muted font-share-tech-mono px-3 mb-3 tracking-[2px] uppercase"
      >// Files</p
    >
    <ul class="space-y-1">
      {
        navItems.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="block px-3 py-2 text-sm text-umbrella-muted hover:text-white hover:bg-white/5 border-l-4 border-transparent hover:border-umbrella-green uppercase tracking-wider font-share-tech-mono transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
